new file mode 100644
index 0000000..edf9aa0
--- /dev/null
+++ b/src/core/chem-engine.ts
@@ -0,0 +1,215 @@
+import { normalizeChemicalFormulaInput } from "../taxonomy";
+
+export interface ChemBalanceResult {
+  ok: boolean;
+  latex: string;
+  balancedText: string;
+  error?: string;
+}
+
+function gcd(a: number, b: number): number {
+  let x = Math.abs(Math.round(a));
+  let y = Math.abs(Math.round(b));
+  while (y !== 0) {
+    const t = y;
+    y = x % y;
+    x = t;
+  }
+  return x || 1;
+}
+
+function lcm(a: number, b: number): number {
+  return Math.abs((a * b) / gcd(a, b));
+}
+
+export function parseChemicalFormulaCounts(rawFormula: string): Record<string, number> {
+  const formula = normalizeChemicalFormulaInput(rawFormula).replace(/[_{}]/g, "");
+  const stack: Array<Record<string, number>> = [{}];
+  let i = 0;
+
+  while (i < formula.length) {
+    const ch = formula[i]!;
+    if (ch === "(" || ch === "[") {
+      stack.push({});
+      i++;
+    } else if (ch === ")" || ch === "]") {
+      i++;
+      let numStr = "";
+      while (i < formula.length && /\d/.test(formula[i]!)) {
+        numStr += formula[i]!;
+        i++;
+      }
+      const mult = numStr ? parseInt(numStr, 10) : 1;
+      const top = stack.pop() ?? {};
+      const parent = stack[stack.length - 1]!;
+      for (const [el, cnt] of Object.entries(top)) {
+        parent[el] = (parent[el] ?? 0) + cnt * mult;
+      }
+    } else if (/[A-Z]/.test(ch)) {
+      let el = ch;
+      i++;
+      if (i < formula.length && /[a-z]/.test(formula[i]!)) {
+        el += formula[i]!;
+        i++;
+      }
+      let numStr = "";
+      while (i < formula.length && /\d/.test(formula[i]!)) {
+        numStr += formula[i]!;
+        i++;
+      }
+      const cnt = numStr ? parseInt(numStr, 10) : 1;
+      const cur = stack[stack.length - 1]!;
+      cur[el] = (cur[el] ?? 0) + cnt;
+    } else {
+      i++;
+    }
+  }
+  return stack[0] ?? {};
+}
+
+/**
+ * Exact rational Gaussian elimination to find the integer nullspace vector
+ * for chemical reaction stoichiometry balancing.
+ */
+function solveStoichiometryNullspace(matrix: number[][], nCols: number): number[] | null {
+  const m = matrix.length;
+  if (m === 0 || nCols < 2) return null;
+
+  // Use exact rational pairs [num, den]
+  type Frac = [number, number];
+  const norm = (a: number, b: number): Frac => {
+    if (a === 0) return [0, 1];
+    const sign = b < 0 ? -1 : 1;
+    const g = gcd(a, b);
+    return [(sign * a) / g, Math.abs(b) / g];
+  };
+  const add = (x: Frac, y: Frac): Frac => norm(x[0] * y[1] + y[0] * x[1], x[1] * y[1]);
+  const sub = (x: Frac, y: Frac): Frac => norm(x[0] * y[1] - y[0] * x[1], x[1] * y[1]);
+  const mul = (x: Frac, y: Frac): Frac => norm(x[0] * y[0], x[1] * y[1]);
+  const div = (x: Frac, y: Frac): Frac => norm(x[0] * y[1], x[1] * y[0]);
+
+  const A: Frac[][] = matrix.map((row) => row.map((v) => [v, 1]));
+  const pivotCols: number[] = [];
+  let rowIdx = 0;
+
+  for (let col = 0; col < nCols && rowIdx < m; col++) {
+    let pivot = -1;
+    for (let r = rowIdx; r < m; r++) {
+      if (A[r]![col]![0] !== 0) {
+        pivot = r;
+        break;
+      }
+    }
+    if (pivot === -1) continue;
+    [A[rowIdx], A[pivot]] = [A[pivot]!, A[rowIdx]!];
+    const pivVal = A[rowIdx]![col]!;
+    for (let c = col; c < nCols; c++) {
+      A[rowIdx]![c] = div(A[rowIdx]![c]!, pivVal);
+    }
+    for (let r = 0; r < m; r++) {
+      if (r === rowIdx) continue;
+      const factor = A[r]![col]!;
+      if (factor[0] === 0) continue;
+      for (let c = col; c < nCols; c++) {
+        A[r]![c] = sub(A[r]![c]!, mul(factor, A[rowIdx]![c]!));
+      }
+    }
+    pivotCols.push(col);
+    rowIdx++;
+  }
+
+  const pivotSet = new Set(pivotCols);
+  const freeCols: number[] = [];
+  for (let c = 0; c < nCols; c++) {
+    if (!pivotSet.has(c)) freeCols.push(c);
+  }
+  if (freeCols.length !== 1) return null;
+
+  const freeCol = freeCols[0]!;
+  const sol: Frac[] = Array.from({ length: nCols }, () => [0, 1] as Frac);
+  sol[freeCol] = [1, 1];
+  for (let r = 0; r < pivotCols.length; r++) {
+    const pCol = pivotCols[r]!;
+    const coeff = A[r]![freeCol]!;
+    sol[pCol] = add([0, 1], [-coeff[0], coeff[1]]);
+  }
+
+  let commonDen = 1;
+  for (const [, den] of sol) {
+    commonDen = lcm(commonDen, den);
+  }
+  const ints = sol.map(([num, den]) => Math.round((num * commonDen) / den));
+  if (ints.some((v) => v <= 0)) {
+    const flipped = ints.map((v) => -v);
+    if (flipped.some((v) => v <= 0)) return null;
+    const g = flipped.reduce((acc, v) => gcd(acc, v));
+    return flipped.map((v) => v / g);
+  }
+  const g = ints.reduce((acc, v) => gcd(acc, v));
+  return ints.map((v) => v / g);
+}
+
+/**
+ * Balances a chemical reaction such as "H2SO4 + NaOH -> Na2SO4 + H2O"
+ * and returns Obsidian-native mhchem LaTeX: \ce{H2SO4 + 2NaOH -> Na2SO4 + 2H2O}
+ */
+export function balanceChemicalEquation(rawReaction: string): ChemBalanceResult {
+  const cleaned = (rawReaction || "")
+    .replace(/^\\ce\{|\}$/g, "")
+    .replace(/\\rightarrow|\\to|-->|=>|=/g, "->")
+    .replace(/\\rightleftharpoons|<->|<=>/g, "<->")
+    .trim();
+
+  const arrow = cleaned.includes("<->") ? "<->" : "->";
+  const parts = cleaned.split(arrow);
+  if (parts.length !== 2) {
+    return { ok: false, latex: rawReaction, balancedText: rawReaction, error: "Expected 'Reactants -> Products'." };
+  }
+
+  const stripLeadingCoeff = (s: string) => s.trim().replace(/^\d+\s*/, "");
+  const reactants = parts[0]!.split("+").map(stripLeadingCoeff).filter(Boolean);
+  const products = parts[1]!.split("+").map(stripLeadingCoeff).filter(Boolean);
+  if (reactants.length === 0 || products.length === 0) {
+    return { ok: false, latex: rawReaction, balancedText: rawReaction, error: "Both reactants and products are required." };
+  }
+
+  const species = [...reactants, ...products];
+  const countsList = species.map(parseChemicalFormulaCounts);
+  const elementSet = new Set<string>();
+  for (const counts of countsList) {
+    for (const el of Object.keys(counts)) elementSet.add(el);
+  }
+  const elements = Array.from(elementSet);
+  const matrix: number[][] = elements.map((el) =>
+    countsList.map((counts, idx) => {
+      const c = counts[el] ?? 0;
+      return idx < reactants.length ? c : -c;
+    })
+  );
+
+  const coeffs = solveStoichiometryNullspace(matrix, species.length);
+  if (!coeffs) {
+    return {
+      ok: false,
+      latex: `\\ce{${cleaned}}`,
+      balancedText: cleaned,
+      error: "Could not find a unique positive integer stoichiometric balance.",
+    };
+  }
+
+  const fmtSide = (items: string[], offset: number) =>
+    items
+      .map((sp, idx) => {
+        const c = coeffs[offset + idx] ?? 1;
+        const normSp = normalizeChemicalFormulaInput(sp).replace(/[_{}]/g, "");
+        return c === 1 ? normSp : `${c}${normSp}`;
+      })
+      .join(" + ");
+
+  const balancedText = `${fmtSide(reactants, 0)} ${arrow} ${fmtSide(products, reactants.length)}`;
+  return {
+    ok: true,
+    latex: `\\ce{${balancedText}}`,
+    balancedText,
+  };
+}
diff --git a/src/core/derivation-renderer.ts b/src/core/derivation-renderer.ts
new file mode 100644
index 0000000..8b25a77
--- /dev/null
+++ b/src/core/derivation-renderer.ts
@@ -0,0 +1,119 @@
+import { MarkdownRenderChild, MarkdownRenderer, Plugin, TFile } from "obsidian";
+import type { DerivationLine } from "../types";
+
+export interface SerializedDerivation {
+  lineNumbers: boolean;
+  lines: DerivationLine[];
+}
+
+/**
+ * Exports derivation lines as pure Obsidian MathJax LaTeX (\begin{aligned}...\end{aligned}).
+ * Text rationales are formatted cleanly on the right; line numbers use \tag{N} when enabled.
+ */
+export function exportDerivationToPureLatex(lines: DerivationLine[], lineNumbers = true): string {
+  const nonEmpty = lines.filter((l) => l.latex.trim().length > 0);
+  if (nonEmpty.length === 0) return "";
+  if (nonEmpty.length === 1 && !nonEmpty[0]!.rationale?.value && !lineNumbers) {
+    return nonEmpty[0]!.latex.trim();
+  }
+
+  const rows = nonEmpty.map((line, idx) => {
+    const expr = line.latex.trim();
+    const ratText = line.rationale?.value
+      ? ` \\quad \\text{(${escapeLatexText(line.rationale.label || line.rationale.value)})}`
+      : "";
+    const tag = lineNumbers ? ` \\tag{${idx + 1}}` : "";
+    return `  &${expr}${ratText}${tag}`;
+  });
+
+  return `\\begin{aligned}\n${rows.join(" \\\\\n")}\n\\end{aligned}`;
+}
+
+function escapeLatexText(s: string): string {
+  return s.replace(/([%$#&_{}])/g, "\\$1");
+}
+
+/**
+ * Exports derivation lines as a ```stem-derivation code block so Obsidian renders
+ * interactive audio players, web links, and external app URI buttons beside each equation line.
+ */
+export function exportDerivationToInteractiveBlock(lines: DerivationLine[], lineNumbers = true): string {
+  const payload: SerializedDerivation = {
+    lineNumbers,
+    lines: lines.filter((l) => l.latex.trim().length > 0),
+  };
+  return "```stem-derivation\n" + JSON.stringify(payload, null, 2) + "\n```";
+}
+
+export function hasRichRationales(lines: DerivationLine[]): boolean {
+  return lines.some((l) => l.rationale && l.rationale.type !== "text" && l.rationale.value.trim().length > 0);
+}
+
+/**
+ * Registers the live Obsidian Markdown code-block renderer for ```stem-derivation blocks.
+ */
+export function registerDerivationBlockProcessor(plugin: Plugin): void {
+  plugin.registerMarkdownCodeBlockProcessor("stem-derivation", async (source, el, ctx) => {
+    el.empty();
+    let data: SerializedDerivation;
+    try {
+      data = JSON.parse(source) as SerializedDerivation;
+    } catch {
+      el.createEl("pre", { text: "Invalid stem-derivation JSON block." });
+      return;
+    }
+
+    const wrapper = el.createDiv({ cls: "lt-rendered-derivation" });
+    const renderComp = new MarkdownRenderChild(wrapper);
+    ctx.addChild(renderComp);
+
+    for (let i = 0; i < (data.lines?.length ?? 0); i++) {
+      const line = data.lines[i]!;
+      const row = wrapper.createDiv({ cls: "lt-rendered-derivation-row" });
+
+      // Column 1: Line number
+      row.createSpan({
+        text: data.lineNumbers !== false ? `${i + 1}.` : "",
+        cls: "lt-line-num",
+      });
+
+      // Column 2: Rendered MathJax equation
+      const mathCell = row.createDiv({ cls: "lt-rendered-math" });
+      await MarkdownRenderer.render(plugin.app, `$$\n${line.latex}\n$$`, mathCell, ctx.sourcePath, renderComp);
+
+      // Column 3: Rich Rationale (text / audio / web link / external app URI)
+      const ratCell = row.createDiv({ cls: "lt-rendered-rationale" });
+      const rat = line.rationale;
+      if (rat && rat.value.trim()) {
+        if (rat.type === "text") {
+          ratCell.createSpan({ text: `(${rat.value})` });
+        } else if (rat.type === "link") {
+          const a = ratCell.createEl("a", {
+            text: `🔗 ${rat.label || rat.value}`,
+            href: rat.value,
+            cls: "external-link",
+          });
+          a.setAttr("target", "_blank");
+          a.setAttr("rel", "noopener noreferrer");
+        } else if (rat.type === "app") {
+          const a = ratCell.createEl("a", {
+            text: `⚡ ${rat.label || "Open App"}`,
+            href: rat.value,
+            cls: "lt-app-link-btn",
+          });
+          a.setAttr("title", rat.value);
+        } else if (rat.type === "audio") {
+          if (rat.label) ratCell.createSpan({ text: `🎙️ ${rat.label}` });
+          const file = plugin.app.vault.getAbstractFileByPath(rat.value);
+          const audioEl = ratCell.createEl("audio");
+          audioEl.controls = true;
+          if (file instanceof TFile) {
+            audioEl.src = plugin.app.vault.getResourcePath(file);
+          } else {
+            audioEl.src = rat.value;
+          }
+        }
+      }
+    }
+  });
+}
diff --git a/src/core/natural-language.ts b/src/core/natural-language.ts
new file mode 100644
index 0000000..4fb418c
--- /dev/null
+++ b/src/core/natural-language.ts
@@ -0,0 +1,213 @@
+import { balanceChemicalEquation } from "./chem-engine";
+
+export type DetectedDomain = "math" | "physics" | "chemistry" | "eee";
+
+export interface NaturalParseResult {
+  domain: DetectedDomain;
+  latex: string;
+  note: string;
+}
+
+export interface NaturalSuggestion {
+  label: string;
+  domain: DetectedDomain;
+  latex: string;
+  description: string;
+}
+
+/**
+ * Automatically detects the STEM domain of a natural-language or symbolic prompt.
+ */
+export function detectStemDomain(input: string): DetectedDomain {
+  const s = (input || "").trim();
+  if (/->|<->|\\ce\{|\b(mol|molar|ph|poh|h2o|h2so4|naoh|co2|nacl|balance)\b/i.test(s)) {
+    return "chemistry";
+  }
+  if (/\b(laplace|ilaplace|phasor|impedance|ohm|kvl|kcl|thevenin|norton|mosfet|bjt|opamp|reactance|db|rms|jw|j\*w|angle|mh|pf|nf|uf|kohm)\b/i.test(s) || /\bZ\s*=/.test(s)) {
+    return "eee";
+  }
+  if (/\b(force|velocity|acceleration|momentum|kinetic|potential|coulomb|lorentz|maxwell|schrodinger|planck|gravity|torque|entropy|wavelength|frequency)\b/i.test(s)) {
+    return "physics";
+  }
+  return "math";
+}
+
+function parseMatlabMatrix(raw: string): string | null {
+  const trimmed = raw.trim();
+  if (!trimmed.startsWith("[") || !trimmed.endsWith("]") || !trimmed.includes(";")) return null;
+  const inner = trimmed.slice(1, -1).trim();
+  const rows = inner
+    .split(";")
+    .map((r) =>
+      r
+        .trim()
+        .split(/[\s,]+/)
+        .filter(Boolean)
+        .join(" & ")
+    )
+    .filter(Boolean);
+  if (rows.length === 0) return null;
+  return `\\begin{pmatrix} ${rows.join(" \\\\ ")} \\end{pmatrix}`;
+}
+
+/**
+ * Converts WolframAlpha / MATLAB / Symbolab-style natural language expressions
+ * into clean LaTeX with MathLive-ready slots where appropriate.
+ */
+export function naturalLanguageToLatex(rawInput: string, imagUnit: "j" | "i" = "j"): NaturalParseResult {
+  const raw = (rawInput || "").trim();
+  const domain = detectStemDomain(raw);
+  if (!raw) return { domain, latex: "", note: "Empty input" };
+
+  // 1. MATLAB matrix syntax: [1 2; 3 4]
+  const mat = parseMatlabMatrix(raw);
+  if (mat) {
+    return { domain: "math", latex: mat, note: "MATLAB matrix → LaTeX" };
+  }
+
+  // 2. Chemistry reaction auto-balance: "balance H2 + O2 -> H2O" or "H2SO4 + NaOH -> Na2SO4 + H2O"
+  if (domain === "chemistry" && (raw.includes("->") || raw.includes("<->"))) {
+    const cleaned = raw.replace(/^balance\s+/i, "");
+    const bal = balanceChemicalEquation(cleaned);
+    return {
+      domain: "chemistry",
+      latex: bal.latex,
+      note: bal.ok ? "Balanced chemical equation (mhchem)" : "Formatted as mhchem reaction",
+    };
+  }
+
+  // 3. Definite integral: "integrate sin(x) from 0 to pi" or "int(x^2, x, 0, 1)"
+  const defIntMatch = raw.match(/^(?:integrate|int)\s+(.+?)\s+from\s+(.+?)\s+to\s+(.+?)(?:\s+d([a-zA-Z]))?$/i);
+  if (defIntMatch?.[1] && defIntMatch[2] && defIntMatch[3]) {
+    const v = defIntMatch[4] || "x";
+    return {
+      domain: "math",
+      latex: `\\int_{${formatExprTokens(defIntMatch[2])}}^{${formatExprTokens(defIntMatch[3])}} ${formatExprTokens(defIntMatch[1])} \\, d${v}`,
+      note: "Definite integral",
+    };
+  }
+
+  // 4. Indefinite integral: "integrate x^2 dx" or "int(sin(x), x)"
+  const indefMatch = raw.match(/^(?:integrate|int)\s+(.+?)(?:\s+d([a-zA-Z])|\s+w\.?r\.?t\.?\s+([a-zA-Z]))?$/i);
+  if (indefMatch?.[1]) {
+    const v = indefMatch[2] || indefMatch[3] || "x";
+    return {
+      domain: "math",
+      latex: `\\int ${formatExprTokens(indefMatch[1])} \\, d${v}`,
+      note: "Indefinite integral",
+    };
+  }
+
+  // 5. Derivative: "diff(x^3 + 2x, x)" or "d/dx sin(x)"
+  const diffMatch = raw.match(/^(?:diff|differentiate|d\/d([a-zA-Z]))\s*\(?(.+?)(?:,\s*([a-zA-Z]))?\)?$/i);
+  if (diffMatch?.[2]) {
+    const v = diffMatch[1] || diffMatch[3] || "x";
+    return {
+      domain: "math",
+      latex: `\\frac{d}{d${v}}\\left(${formatExprTokens(diffMatch[2])}\\right)`,
+      note: "Derivative",
+    };
+  }
+
+  // 6. Limit: "limit sin(x)/x as x -> 0"
+  const limMatch = raw.match(/^(?:limit|lim)\s+(.+?)\s+(?:as\s+)?([a-zA-Z])\s*(?:->|to)\s*(.+)$/i);
+  if (limMatch?.[1] && limMatch[2] && limMatch[3]) {
+    return {
+      domain: "math",
+      latex: `\\lim_{${limMatch[2]} \\to ${formatExprTokens(limMatch[3])}} ${formatExprTokens(limMatch[1])}`,
+      note: "Limit",
+    };
+  }
+
+  // 7. Summation: "sum k^2 from k=1 to n"
+  const sumMatch = raw.match(/^sum\s+(.+?)\s+from\s+([a-zA-Z]\s*=\s*.+?)\s+to\s+(.+)$/i);
+  if (sumMatch?.[1] && sumMatch[2] && sumMatch[3]) {
+    return {
+      domain: "math",
+      latex: `\\sum_{${formatExprTokens(sumMatch[2])}}^{${formatExprTokens(sumMatch[3])}} ${formatExprTokens(sumMatch[1])}`,
+      note: "Summation",
+    };
+  }
+
+  // 8. Laplace / Inverse Laplace (EEE / Control)
+  const lapMatch = raw.match(/^(i?laplace)\s*\((.+)\)$/i);
+  if (lapMatch?.[1] && lapMatch[2]) {
+    const isInv = lapMatch[1].toLowerCase().startsWith("i");
+    return {
+      domain: "eee",
+      latex: isInv
+        ? `\\mathcal{L}^{-1}\\left\\{${formatExprTokens(lapMatch[2])}\\right\\}`
+        : `\\mathcal{L}\\left\\{${formatExprTokens(lapMatch[2])}\\right\\}`,
+      note: isInv ? "Inverse Laplace transform" : "Laplace transform",
+    };
+  }
+
+  // 9. Phasor notation: "10 angle 30 deg" -> 10\angle 30^{\circ}
+  const phasorMatch = raw.match(/^(.+?)\s+(?:angle|ang)\s+(.+?)(?:\s*deg)?$/i);
+  if (phasorMatch?.[1] && phasorMatch[2]) {
+    return {
+      domain: "eee",
+      latex: `${formatExprTokens(phasorMatch[1])}\\angle ${formatExprTokens(phasorMatch[2])}^{\\circ}`,
+      note: "EEE Phasor",
+    };
+  }
+
+  // 10. General token & operator normalization
+  return {
+    domain,
+    latex: formatExprTokens(raw, imagUnit),
+    note: `Symbolic conversion (${domain.toUpperCase()})`,
+  };
+}
+
+function formatExprTokens(expr: string, imagUnit: "j" | "i" = "j"): string {
+  let out = expr.trim();
+  // Fractions a/b when parenthesized or simple tokens
+  out = out.replace(/\(([^()]+)\)\s*\/\s*\(([^()]+)\)/g, "\\frac{$1}{$2}");
+  out = out.replace(/\b([a-zA-Z0-9]+)\s*\/\s*([a-zA-Z0-9]+)\b/g, "\\frac{$1}{$2}");
+  // Functions
+  out = out.replace(/\bsqrt\(([^)]+)\)/gi, "\\sqrt{$1}");
+  out = out.replace(/\b(sin|cos|tan|cot|sec|csc|sinh|cosh|tanh|ln|log|exp)\b/gi, (m) => `\\${m.toLowerCase()}`);
+  // Constants & Greek
+  out = out.replace(/\b(alpha|beta|gamma|delta|epsilon|zeta|eta|theta|lambda|mu|nu|xi|pi|rho|sigma|tau|phi|chi|psi|omega)\b/gi, (m) => `\\${m.toLowerCase()}`);
+  out = out.replace(/\binf(?:inity)?\b/gi, "\\infty");
+  out = out.replace(/\bdeg\b/gi, "^{\\circ}");
+  out = out.replace(/\bohm\b/gi, "\\Omega");
+  out = out.replace(/\bj\*?\\omega\b/gi, `${imagUnit}\\omega`);
+  out = out.replace(/\*/g, " \\cdot ");
+  out = out.replace(/<=/g, " \\leq ").replace(/>=/g, " \\geq ").replace(/!=/g, " \\neq ");
+  return out;
+}
+
+const BUILTIN_SUGGESTIONS: NaturalSuggestion[] = [
+  { label: "Definite Integral", domain: "math", latex: "\\int_{\\placeholder[a]{0}}^{\\placeholder[b]{\\infty}} \\placeholder[f]{f(x)} \\, dx", description: "integrate f(x) from a to b" },
+  { label: "Derivative d/dx", domain: "math", latex: "\\frac{d}{dx}\\left(\\placeholder[f]{x^2}\\right)", description: "diff(x^2, x)" },
+  { label: "Limit", domain: "math", latex: "\\lim_{\\placeholder[v]{x} \\to \\placeholder[p]{0}} \\placeholder[f]{\\frac{\\sin x}{x}}", description: "limit sin(x)/x as x -> 0" },
+  { label: "Summation", domain: "math", latex: "\\sum_{\\placeholder[k]{k=1}}^{\\placeholder[n]{n}} \\placeholder[term]{k^2}", description: "sum k^2 from k=1 to n" },
