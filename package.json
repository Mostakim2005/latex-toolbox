{
	"name": "obsidian-latex-toolbox",
	"version": "1.8.0",
	"description": "A modular scientific LaTeX assistant for Obsidian.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "tsc -p tests/tsconfig.json --pretty false && node tests/run-all.mjs",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"verify:release": "node scripts/verify-release.mjs"
	},
	"keywords": ["obsidian", "latex", "math", "physics", "chemistry", "science"],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
