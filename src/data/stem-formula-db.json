    "branch": "math",
    "level": "a-level-ib",
    "topic": "Probability & Statistics",
    "latex": "P(X = ${1:k}) = \\binom{${2:n}}{${1:k}}\\,${3:p}^{${1:k}}\\,\\left(1 - ${3:p}\\right)^{${2:n} - ${1:k}}",
