      { "key": "a", "symbol": "a", "meaning": "Acceleration", "unit": "m/s^2", "defaultValue": 2 },
      { "key": "s", "symbol": "s", "meaning": "Displacement", "unit": "m", "defaultValue": 10 }
    ],
    "tags": ["suvat", "velocity", "kinematics"]
  },
