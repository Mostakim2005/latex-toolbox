  {
    "id": "phy-suvat-s",
    "name": "Uniform Acceleration — Displacement (SUVAT)",
    "branch": "physics",
    "level": "o-level",
    "topic": "Kinematics",
    "latex": "s = ${1:u}\\,t + \\frac{1}{2}\\,${2:a}\\,t^2",
    "definition": "Displacement under constant acceleration a from initial velocity u over time t (O-Level / A-Level / IB).",
    "outputSymbol": "s",
    "outputUnit": "m",
    "calcExpr": "u * t + 0.5 * a * t^2",
    "variables": [
      { "key": "u", "symbol": "u", "meaning": "Initial velocity", "unit": "m/s", "defaultValue": 0 },
      { "key": "a", "symbol": "a", "meaning": "Acceleration", "unit": "m/s^2", "defaultValue": 9.81 },
      { "key": "t", "symbol": "t", "meaning": "Time", "unit": "s", "defaultValue": 3 }
    ],
    "tags": ["suvat", "kinematics", "o-level", "a-level", "ib"]
  },
  {
    "id": "phy-suvat-v",
    "name": "Velocity-Displacement Equation",
