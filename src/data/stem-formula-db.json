    "level": "o-level",
    "topic": "Kinematics",
    "latex": "v = \\sqrt{${1:u}^2 + 2\\,${2:a}\\,${3:s}}",
    "definition": "Final velocity from initial velocity, acceleration, and displacement.",
    "outputSymbol": "v",
    "outputUnit": "m/s",
    "calcExpr": "sqrt(u^2 + 2 * a * s)",
